  "dataModel": {
    "entities": [
      {
        "name": "Workspace",
        "fields": ["workspaceId", "name", "createdAt", "updatedAt"]
      },
      {
        "name": "ApiKey",
        "fields": ["apiKeyId", "workspaceId", "keyHash", "name", "createdAt", "revokedAt"]
      },
      {
        "name": "Agent",
        "fields": ["agentId", "workspaceId", "name", "modelConfig", "systemPrompt", "memoryConfig", "toolRunnerUrl", "createdAt", "updatedAt"]
      },
      {
        "name": "Session",
        "fields": ["sessionId", "agentId", "userId", "status", "metadata", "createdAt", "closedAt"]
      },
      {
        "name": "Message",
        "fields": ["messageId", "sessionId", "runId", "role", "content", "createdAt"]
      },
      {
        "name": "Run",
        "fields": ["runId", "sessionId", "status", "model", "tokenUsage", "startedAt", "completedAt"]
      },
      {
        "name": "ToolCall",
        "fields": ["callId", "runId", "toolName", "input", "output", "status", "startedAt", "completedAt"]
      },
      {
        "name": "Trace",
        "fields": ["traceId", "runId", "rootSpanId", "startedAt", "completedAt", "totalDurationMs"]
      },
      {
        "name": "TraceSpan",
        "fields": ["spanId", "traceId", "parentSpanId", "type", "name", "startedAt", "completedAt", "durationMs", "metadata", "status", "error"]
      }
    ]
  },
  "streamProtocol": {
    "events": [
      "message_started",
      "token",
      "tool_call_started",
      "tool_call_completed",
      "message_completed",
      "run_failed"
    ]
  },
  "outOfScope": [
    "Durable long-running job execution",
    "Multi-agent orchestration / planner",
    "Hosted secrets management",
    "Complex workflow builder",
    "Vector database / RAG infrastructure",
    "Browser automation tools",
    "Prompt versioning / management",
    "Model fallback rules"
  ]
}
