{
  "program": {
    "id": "product-x",
    "name": "Swift Agent — Phase 1 MVP",
    "description": "Hosted real-time agent runtime: SDK to streaming UI for multi-model, tool-calling AI agents.",
    "status": "completed",
    "phase": 1,
    "created": "2026-04-01",
    "completed": "2026-07-15"
  },
  "technology": {
    "language": "TypeScript",
    "runtime": "Node.js",
    "monorepo": "pnpm workspaces + Turborepo",
    "framework": "Fastify",
    "database": "PostgreSQL",
    "orm": "Drizzle",
    "cache": "Redis (ioredis)",
    "transport": "WebSocket (ws)",
    "testing": "Vitest",
    "validation": "Zod",
    "logging": "pino",
    "cloud": "AWS (ECS Fargate, RDS, ElastiCache, ALB, ECR)",
    "iac": "Terraform",
    "ci_cd": "GitHub Actions"
  },
  "packages": [
    {
      "name": "@swiftagent/shared",
      "path": "packages/shared",
      "description": "Shared types, event protocol, constants, and utilities"
    },
    {
      "name": "@swiftagent/db",
      "path": "packages/db",
      "description": "PostgreSQL schema, migrations, and typed repositories"
    },
    {
      "name": "@swiftagent/models",
      "path": "packages/models",
      "description": "Unified model provider abstraction (OpenAI, Anthropic, Google)"
    },
    {
      "name": "@swiftagent/runtime",
      "path": "packages/runtime",
      "description": "Agent runtime engine: message loop, tool orchestration, memory"
    },
    {
      "name": "@swiftagent/gateway",
      "path": "packages/gateway",
      "description": "WebSocket realtime gateway: connection auth, multiplexing, streaming"
    },
    {
      "name": "@swiftagent/api",
      "path": "packages/api",
      "description": "Control plane REST API: sessions, agents, tokens"
    },
    {
      "name": "@swiftagent/sdk",
      "path": "packages/sdk",
      "description": "Server-side SDK: agent/tool definition DSL, tool runner"
    },
    {
      "name": "@swiftagent/react",
      "path": "packages/react",
      "description": "Client-side React hooks and vanilla JS WebSocket client"
    },
    {
      "name": "@swiftagent/observability",
      "path": "packages/observability",
      "description": "Structured tracing, run-level logs, and event capture"
    }
  ],
