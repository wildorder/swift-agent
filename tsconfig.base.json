{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "paths": {
      "@swiftagent/shared": ["./packages/shared/src/index.ts"],
      "@swiftagent/db": ["./packages/db/src/index.ts"],
      "@swiftagent/models": ["./packages/models/src/index.ts"],
      "@swiftagent/runtime": ["./packages/runtime/src/index.ts"],
      "@swiftagent/gateway": ["./packages/gateway/src/index.ts"],
      "@swiftagent/api": ["./packages/api/src/index.ts"],
      "@swiftagent/sdk": ["./packages/sdk/src/index.ts"],
      "@swiftagent/react": ["./packages/react/src/index.ts"],
      "@swiftagent/observability": ["./packages/observability/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
