{
  "name": "swift-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "test:integration": "vitest run --config test/vitest.integration.config.ts",
    "test:acceptance": "vitest run --config test/vitest.acceptance.config.ts",
    "test:acceptance:install": "tsx test/acceptance/install-published.ts",
    "verify:local-registry": "node scripts/local-registry.mjs verify",
    "e2e:create-swift-agent": "node scripts/create-swift-agent-e2e.mjs",
    "smoke:realtime": "tsx test/smoke/realtime-smoke.ts",
    "smoke:local": "tsx test/smoke/local-smoke-entry.ts",
    "smoke:typecheck": "tsc --noEmit -p test/smoke/tsconfig.json",
    "smoke:lint": "eslint test/smoke",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "@swiftagent/api": "workspace:^",
    "@swiftagent/db": "workspace:^",
    "@swiftagent/gateway": "workspace:^",
    "@swiftagent/models": "workspace:^",
    "@swiftagent/observability": "workspace:^",
    "@swiftagent/runtime": "workspace:^",
    "@swiftagent/sdk": "workspace:^",
    "@swiftagent/shared": "workspace:^",
    "@testcontainers/postgresql": "^10.0.0",
    "@types/node": "^25.5.2",
    "@types/ws": "^8.18.1",
    "@wildorder/program-pipeline": "^0.16.1",
    "drizzle-orm": "^0.36",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "fastify": "^5",
    "jose": "^6",
    "postgres": "^3.4.0",
    "prettier": "^3.0.0",
    "testcontainers": "^10.0.0",
    "tsx": "^4.19.2",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "verdaccio": "6",
    "vitest": "^3.0.0",
    "ws": "^8.20.0",
    "zod": "^3.24"
  }
}
