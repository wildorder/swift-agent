{
  "name": "@swiftagent/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist .turbo",
    "db:generate": "tsc && drizzle-kit generate",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@swiftagent/shared": "workspace:*",
    "drizzle-orm": "^0.36",
    "postgres": "^3.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "drizzle-kit": "^0.30",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
