# ── __PROJECT_NAME__ — environment ────────────────────────────────────────────
# Copy to `.env` and fill in values (create-swift-agent already wrote `.env`
# for you). docker compose reads this file for variable substitution AND passes
# it to the Swift Agent server (env_file); the backend loads it too when run on
# the host. Never commit `.env` — the generated .gitignore covers it.

# Model-provider API key (server-side only; used once you switch off the
# fixture model below).
__PROVIDER_KEY_ENV__=

# Model the in-compose backend registers. Unset = the zero-key deterministic
# fixture model (`fixture/tool-call`) so the stack works with no provider key.
# Uncomment to use your real provider (requires the key above):
# COMPOSE_AGENT_MODEL=__DEFAULT_MODEL__

# Swift Agent server image for docker compose (until an official image is
# published, build one from a swift-agent checkout and point this at the tag):
# SWIFT_AGENT_SERVER_IMAGE=swift-agent-server:local

# ── Host-run backend (`npm run dev` in backend/) ─────────────────────────────
# The compose `backend` service sets these itself; they matter only when you
# run the backend directly on your machine.
SWIFT_AGENT_BASE_URL=http://127.0.0.1:3000
# Either paste the key minted by `docker compose up` (printed by the bootstrap
# service) or leave the *_FILE fallback pointing at the bootstrap output:
SWIFT_AGENT_API_KEY=
SWIFT_AGENT_API_KEY_FILE=../.swiftagent-local/dev-api-key
# Runner workspace id handoff written by the bootstrap:
RUNNER_ENV_FILE=../.swiftagent-local/runner-env.json
# DEV ONLY — public half of the compose stack's committed dev runner keypair.
RUNNER_TOKEN_PUBLIC_KEY='{"crv":"Ed25519","x":"AtVR_YILLC99-cB21IYSh14yrVE78bz9KwnrwAw1Vv4","kty":"OKP"}'
# Port for the /api/session route (the tool runner uses RUNNER_PORT, 8787).
PORT=4000
