    "@swiftagent/shared": "workspace:*",
    "fastify": "^5",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsx": "^4.19.2",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
