{
  "name": "@swiftagent/example-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Swift Agent quickstart backend — one agent, one tool, and a /api/session route.",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
