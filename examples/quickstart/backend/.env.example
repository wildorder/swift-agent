# ── Swift Agent quickstart backend — environment ──────────────────────────────
# Copy to `.env` and fill in real values. Only needed to RUN the backend;
# `pnpm typecheck` / `pnpm build` never read these.

# Workspace API key → createAgentApp({ apiKey }). The backend owns this secret;
# the browser never sees it.
SWIFT_AGENT_API_KEY=

# Control-plane (apps/server) base URL → createAgentApp({ baseUrl }).
SWIFT_AGENT_BASE_URL=http://127.0.0.1:3000

# Runner token verification key — PEM (SPKI) or JWK JSON. Required by app.listen().
RUNNER_TOKEN_PUBLIC_KEY=

# The runner's owning workspace (ws_...) id. Required by app.listen().
RUNNER_WORKSPACE_ID=

# Optional — the runner's audience. Defaults to the runner's public URL when unset.
RUNNER_AUDIENCE=

# Optional — the runner's externally reachable base URL (used as the audience default).
TOOL_RUNNER_PUBLIC_URL=

# Port for the /api/session HTTP route (the tool runner picks its own port).
PORT=4000
